# copy to .env  ->  cp .env.example .env   (do NOT commit .env)
POSTGRES_USER=adnews
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=adnews
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_local_only

# optional demo switches
# SIMULATE_DOWN=positioning     # pretend a source is down (DAG must continue)
# QUALITY_MIN_ROWS=9999         # force the quality gate to fail -> quarantine branch
# POSITIONING_MAX=60            # max Positioning articles fetched per run
# SCRAPER_DELAY=1.0             # seconds between requests
